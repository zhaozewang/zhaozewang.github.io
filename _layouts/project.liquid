<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {% if page._styles %}
      <!-- Custom styles for this project page -->
      <style type="text/css">
        {{ page._styles }}
      </style>
    {% endif %}
  </head>
  <body>
    <div class="container">
      <div class="post">
        <header class="post-header">
          <div class="post-title">{{ page.title }}</div>
          <p class="post-description">{{ page.description }}</p>

          <div class="authors">
            {% for author in page.authors %}
              <span class="author">
                {% if author.url %}
                  <a href="{{ author.url }}">{{ author.name }}</a>
                {% else %}
                  {{ author.name }}
                {% endif %}

                <!-- Display superscript if it exists -->
                {% if author.superscript %}
                  <sup style="font-size: xx-small;">{{ author.superscript }}</sup>
                {% endif %}
              </span>
              {%- if forloop.last == false %}, {% endif %}
            {% endfor %}
          </div>

          <div class="affiliations">
            <span class="affiliation">{{ page.affiliations }}</span>
          </div>
        </header>

        <!-- Buttons section -->
        <div class="buttons">
          {% if page.paper_link %}
            <a class="button" href="{{ page.paper_link }}" target="_blank">Paper</a>
          {% endif %}
          {% if page.arxiv_link %}
            <a class="button" href="{{ page.arxiv_link }}" target="_blank">arXiv</a>
          {% endif %}
          {% if page.open_review_link %}
            <a class="button" href="{{ page.open_review_link }}" target="_blank">OpenReview</a>
          {% endif %}
          {% if page.code_link %}
            <a class="button" href="{{ page.code_link }}" target="_blank">Code</a>
          {% endif %}
          {% if page.related_project_link %}
            <a class="button" href="{{ page.related_project_link }}" target="_blank">Related</a>
          {% endif %}
          {% if page.data_link %}
            <a class="button" href="{{ page.data_link }}" target="_blank">Data</a>
          {% endif %}
        </div>

        <!-- Main content section (Markdown content) -->
        <article class="post-content">
          {{ content }}
        </article>

        {% if page.citation %}
          <h3>Cite this Paper</h3>
          <div class="citation">{{ page.citation }}</div>
        {% endif %}
      </div>
    </div>
  </body>
</html>
